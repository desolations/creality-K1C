shaper_freq_y = 76.4
shaper_type_x = ei
shaper_freq_x = 76.4

[bed_mesh default]
version = 1
points = 
	-0.469156, -0.285094, -0.220563, -0.119313, 0.001469
	-0.292094, -0.127051, -0.029281, 0.064219, 0.172969
	-0.153719, 0.001021, 0.068000, 0.151906, 0.249406
	-0.264469, -0.094938, -0.045525, -0.007750, 0.073969
	-0.467562, -0.389438, -0.315063, -0.261469, -0.228906
x_count = 5
y_count = 5
mesh_x_pps = 2
